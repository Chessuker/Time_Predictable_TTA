; GENERATED by `py -m host.hil.programs` (host/hil/programs.py). Do not edit.
;
; Switch mode: the PID of control.tta, with the setpoint taken from io.din
; (din[1:0] -> SP_TABLE, committed with BTN0; din[2] is the load switch, logged only).
;   anchor + 1     sense    (io.encoder)
;   anchor + 2     input    (io.din)
;   anchor + 1001  actuate  (io.pwm_cmd)
;   anchor + 2000  deadline
; Telemetry per period: SW_MAGIC, k, din, ref, encoder, pwm_cmd, elapsed after the
;   inputs, elapsed after actuate, tmr.flags   (host/hil/board.py --switch reads it)

.equ PERIOD,   100000
.equ ACT,      1000
.equ DEADLINE, 2000
.equ KPQ,      186659
.equ KDQ,      1501851
.equ KIQ,      6766
.equ HALF,     32768
.equ SH,       16
.equ ECLAMP,   4096
.equ UMAX,     2047

        #on_trap    -> trap.handler
        #0          -> tmr.t_sync
@task control
loop:   #PERIOD     -> tmr.t_advance
        io.encoder  -> r1               ; sense: anchor + 1
        io.din      -> r4               ; input: anchor + 2
        tmr.elapsed -> r14              ; anchor + 3
        #DEADLINE   -> tmr.t_arm
        ; setpoint = SP_TABLE[din & 3], a lookup: the same moves for every din
        #AND        -> alu.op
        r4          -> alu.a
        #3          -> alu.t_b
        #ADD        -> alu.op
        alu.out     -> alu.a
        #sptab      -> alu.t_b
        alu.out     -> mem.t_load
        mem.data_out -> r10             ; setpoint
        r10         -> r13              ; setpoint of this period, for telemetry
        ; e = clamp(ref - enc, -ECLAMP, ECLAMP)
        #SUB        -> alu.op
        r10         -> alu.a
        r1          -> alu.t_b
        #MIN        -> alu.op
        alu.out     -> alu.a
        #ECLAMP     -> alu.t_b
        #MAX        -> alu.op
        alu.out     -> alu.a
        #-ECLAMP    -> alu.t_b
        alu.out     -> r2               ; e
        ; p = KPQ * e, d = KDQ * (enc - prev), prev = enc
        #KPQ        -> mul.a
        r2          -> mul.t_b
        #SUB        -> alu.op           ; fills the MUL latency slot
        mul.out     -> r3               ; p
        r1          -> alu.a
        r8          -> alu.t_b          ; enc - prev
        r1          -> r8               ; prev = enc
        #KDQ        -> mul.a
        alu.out     -> mul.t_b
        r3          -> alu.a            ; fills the MUL latency slot
        mul.out     -> alu.t_b          ; p - d
        #ADD        -> alu.op
        alu.out     -> alu.a
        r5          -> alu.t_b          ; + acc
        alu.out     -> alu.a
        #HALF       -> alu.t_b          ; round half up
        #SRA        -> alu.op
        alu.out     -> alu.a
        #SH         -> alu.t_b
        alu.out     -> r6               ; u before saturation
        #MIN        -> alu.op
        r6          -> alu.a
        #UMAX       -> alu.t_b
        #MAX        -> alu.op
        alu.out     -> alu.a
        #-UMAX      -> alu.t_b
        alu.out     -> r7               ; u
        ; anti-windup: integrate unless saturated with e pushing the same way (e * u > 0)
        r6          -> cmp.a
        r7          -> cmp.t_b
        cmp.eq      -> pc.cond
        #integ      -> pc.t_jnz         ; not saturated
        #0          -> cmp.a
        r7          -> cmp.t_b          ; 0 < u ?
        cmp.lt      -> pc.cond
        #u_neg      -> pc.t_jz
        r2          -> cmp.t_b          ; u > 0: hold if 0 < e
        cmp.lt      -> pc.cond
        #sched_up   -> pc.t_jnz
        #integ      -> pc.t_jump
u_neg:  r2          -> cmp.a            ; u < 0: hold if e < 0
        #0          -> cmp.t_b
        cmp.lt      -> pc.cond
        #sched_up   -> pc.t_jnz
integ:  #KIQ        -> mul.a
        r2          -> mul.t_b
        #ADD        -> alu.op           ; fills the MUL latency slot
        mul.out     -> alu.a
        r5          -> alu.t_b          ; acc + KIQ * e
        #MIN        -> alu.op
        alu.out     -> alu.a
        #amax       -> mem.t_load
        mem.data_out -> alu.t_b
        #MAX        -> alu.op
        alu.out     -> alu.a
        #amin       -> mem.t_load
        mem.data_out -> alu.t_b
        alu.out     -> r5               ; acc
sched_up: nop                   ; no schedule: the setpoint comes from io.din
        #ACT        -> tmr.t_wait
        r7          -> io.pwm_cmd       ; actuate: anchor + ACT + 1
        tmr.elapsed -> r15              ; anchor + ACT + 2
        #0          -> tmr.t_clear
        #magic      -> mem.t_load
        mem.data_out -> telem.t_push
        r9          -> telem.t_push     ; k
        r4          -> telem.t_push     ; din
        r13         -> telem.t_push     ; setpoint
        r1          -> telem.t_push     ; encoder
        r7          -> telem.t_push     ; pwm_cmd
        r14         -> telem.t_push     ; elapsed after the inputs
        r15         -> telem.t_push     ; elapsed after actuate
        tmr.flags   -> telem.t_push
        #ADD        -> alu.op
        r9          -> alu.a
        #1          -> alu.t_b
        alu.out     -> r9               ; k + 1
        #loop       -> pc.t_jump

; deadline trap: make the plant safe, report, stop (no return from a trap)
.func on_trap
        tmr.elapsed -> r15              ; first handler move: deadline + 1 + H
        #0          -> io.pwm_cmd
        #tmagic     -> mem.t_load
        mem.data_out -> telem.t_push
        trap.cause  -> telem.t_push
        trap.epc    -> telem.t_push
        r15         -> telem.t_push
        r9          -> telem.t_push
        #0          -> trap.t_halt
.endfunc

        .data
magic:  .word 0x48535731
tmagic: .word 0x54524150
amax:   .word 134152192
amin:   .word -134152192
sptab:  .word 0, 4096, -4096, 2048   ; setpoint by din[1:0]
